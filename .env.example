# eval-platform 独立配置 —— 复制为 .env 后填写
# 平台默认的模型端点(OpenAI 兼容); 各模块可在 module_config.json 里覆盖
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# 本地 Langfuse 栈(--profile langfuse)的密钥, 全部必填否则 langfuse-web 起不来
# 生成方式: openssl rand -hex 16 (SALT/SECRET) / openssl rand -hex 32 (ENCRYPTION_KEY)
LF_NEXTAUTH_URL=http://localhost:3000
LF_UI_URL=http://localhost:3000
LF_NEXTAUTH_SECRET=changeme
LF_SALT=changeme
LF_ENCRYPTION_KEY=changeme
LF_PUBLIC_KEY=pk-lf-xxxx
LF_SECRET_KEY=sk-lf-xxxx
LF_ADMIN_PASSWORD=changeme
